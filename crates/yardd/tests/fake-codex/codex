#!/usr/bin/env bun
// A scripted stand-in for `codex app-server`, for yardd's integration tests.
// Tests put this folder first on PATH, so yardd runs it instead of the real
// CLI and no turn ever reaches a model.
//
// A turn's behaviour is picked by a marker in the prompt:
//   [cmd]   a command that needs approval, then runs or is declined
//   [edit]  a file change with a diff
//   [slow]  streams one chunk, then waits for turn/interrupt
//   [fail]  the turn fails with an error
//   other   a plain streamed reply: "Echo: <prompt>"
//
// FAKE_CODEX_DIR (set by the tests) gets `codex.log`, one line per start and
// per request, `turn-inputs.jsonl` with the input items of every turn/start,
// and `threads.json`, so a restarted fake can resume a thread the previous
// one started, and refuses one it never saw.

import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";

const dir = process.env.FAKE_CODEX_DIR;
const log = (line) => {
  if (dir) appendFileSync(`${dir}/codex.log`, `${line}\n`);
};

log(`start pid=${process.pid} args=${process.argv.slice(2).join(" ")}`);
if (process.argv[2] !== "app-server") {
  console.error("fake codex: only `app-server` is implemented");
  process.exit(2);
}

const threadsFile = dir ? `${dir}/threads.json` : null;
const threads = new Map(
  threadsFile && existsSync(threadsFile) ? JSON.parse(readFileSync(threadsFile, "utf8")) : [],
);
const saveThreads = () => {
  if (threadsFile) writeFileSync(threadsFile, JSON.stringify([...threads]));
};

let counter = 0;
const newId = (prefix) => `${prefix}-${process.pid}-${++counter}`;

const write = (msg) => process.stdout.write(`${JSON.stringify(msg)}\n`);
const notify = (method, params) => write({ method, params });

// Server-to-client requests (approvals) waiting for the client's answer.
let nextServerId = 1000;
const waiting = new Map();
const ask = (method, params) =>
  new Promise((resolve) => {
    const id = nextServerId++;
    waiting.set(id, resolve);
    write({ id, method, params });
  });

// Running turns, by turn id: whether each was interrupted, and how to wake a slow one.
const running = new Map();

const MODELS = [
  {
    id: "fake-fast",
    model: "fake-fast",
    displayName: "Fake Fast",
    description: "Scripted test model",
    hidden: false,
    isDefault: true,
    defaultReasoningEffort: "low",
    supportedReasoningEfforts: [
      { reasoningEffort: "low", description: "Quick" },
      { reasoningEffort: "high", description: "Careful" },
    ],
  },
  {
    id: "fake-deep",
    model: "fake-deep",
    displayName: "Fake Deep",
    description: "Second scripted test model",
    hidden: false,
    isDefault: false,
    defaultReasoningEffort: "medium",
    supportedReasoningEfforts: [
      { reasoningEffort: "medium", description: "Balanced" },
      { reasoningEffort: "xhigh", description: "Thorough" },
    ],
  },
];

const threadInfo = (id, cwd) => ({
  id,
  cwd,
  preview: "",
  ephemeral: false,
  modelProvider: "fake",
  createdAt: 0,
  updatedAt: 0,
  status: { type: "idle" },
  turns: [],
});

const threadResponse = (id, p) => ({
  thread: threadInfo(id, p.cwd ?? threads.get(id)?.cwd ?? ""),
  model: p.model ?? "fake-fast",
  modelProvider: "fake",
  cwd: p.cwd ?? threads.get(id)?.cwd ?? "",
  approvalPolicy: p.approvalPolicy ?? "on-request",
  approvalsReviewer: "user",
  sandbox: { type: "workspaceWrite" },
});

async function handle(msg) {
  const { id, method, params: p = {} } = msg;
  const reply = (result) => write({ id, result });
  const fail = (message) => write({ id, error: { code: -32600, message } });
  log(`req ${method}${p.threadId ? ` ${p.threadId}` : ""}`);

  switch (method) {
    case "initialize":
      return reply({ userAgent: "fake-codex/0", codexHome: "/nonexistent", platformFamily: "unix", platformOs: "macos" });
    case "model/list":
      return reply({ data: MODELS, nextCursor: null });
    case "account/rateLimits/read":
      return reply({
        rateLimits: {
          limitId: "codex",
          primary: { usedPercent: 12, windowDurationMins: 300, resetsAt: null },
          secondary: null,
        },
      });
    case "thread/start": {
      const tid = newId("thread");
      threads.set(tid, { cwd: p.cwd ?? "" });
      saveThreads();
      return reply(threadResponse(tid, p));
    }
    case "thread/resume": {
      if (!threads.has(p.threadId)) return fail(`no such thread: ${p.threadId}`);
      return reply(threadResponse(p.threadId, p));
    }
    case "turn/start": {
      const thread = threads.get(p.threadId);
      if (!thread) return fail(`no such thread: ${p.threadId}`);
      // Every input item, so tests can check what reached the engine.
      if (dir) appendFileSync(`${dir}/turn-inputs.jsonl`, `${JSON.stringify({ threadId: p.threadId, input: p.input })}\n`);
      const text = (p.input ?? []).filter((i) => i.type === "text").map((i) => i.text).join("\n");
      const turn = { id: newId("turn"), items: [], status: "inProgress", error: null };
      // Registered before the reply, so an interrupt that arrives before the
      // turn's first event still finds it.
      running.set(turn.id, { interrupted: false, wake: () => {} });
      reply({ turn });
      // After the reply, as the real server does.
      setTimeout(() => runTurn(p.threadId, thread.cwd, turn, text), 0);
      return;
    }
    case "turn/interrupt": {
      const ctl = running.get(p.turnId);
      if (!ctl) return fail(`no running turn ${p.turnId}`);
      reply({});
      ctl.interrupted = true;
      ctl.wake();
      return;
    }
    default:
      return fail(`fake codex does not implement ${method}`);
  }
}

async function runTurn(threadId, cwd, turn, text) {
  const turnId = turn.id;
  const item = (method, it) => notify(method, { threadId, turnId, item: it, startedAtMs: 0, completedAtMs: 0 });
  const finish = (status, error = null) => {
    running.delete(turnId);
    notify("turn/completed", { threadId, turn: { ...turn, status, error } });
  };
  const say = (answer, chunks) => {
    const itemId = newId("msg");
    for (const chunk of chunks) notify("item/agentMessage/delta", { threadId, turnId, itemId, delta: chunk });
    item("item/completed", { type: "agentMessage", id: itemId, text: answer });
  };

  notify("turn/started", { threadId, turn });

  if (text.includes("[slow]")) {
    const itemId = newId("msg");
    const ctl = running.get(turnId);
    notify("item/agentMessage/delta", { threadId, turnId, itemId, delta: "Working" });
    if (!ctl.interrupted) await new Promise((resolve) => (ctl.wake = resolve));
    return finish("interrupted");
  }

  if (text.includes("[fail]")) {
    return finish("failed", { message: "fake failure: the model is unavailable", codexErrorInfo: null, additionalDetails: null });
  }

  if (text.includes("[cmd]")) {
    const itemId = newId("cmd");
    const command = "/bin/bash -lc 'echo approved'";
    const base = { type: "commandExecution", id: itemId, command, cwd, commandActions: [] };
    item("item/started", { ...base, status: "inProgress" });
    const answer = await ask("item/commandExecution/requestApproval", {
      threadId,
      turnId,
      itemId,
      startedAtMs: 0,
      command,
      cwd,
      reason: "needs to run a command",
    });
    const decision = answer?.result?.decision;
    if (decision === "accept" || decision === "acceptForSession") {
      item("item/completed", { ...base, status: "completed", exitCode: 0, aggregatedOutput: "approved\n" });
      say("Ran it.", ["Ran ", "it."]);
    } else {
      item("item/completed", { ...base, status: "declined", exitCode: null, aggregatedOutput: null });
      say("Skipped it.", ["Skipped it."]);
    }
    return finish("completed");
  }

  if (text.includes("[edit]")) {
    const itemId = newId("edit");
    const changes = [
      {
        path: `${cwd.replace(/\/$/, "")}/src/lib.rs`,
        kind: { type: "update", move_path: null },
        diff: "@@ -1 +1,2 @@\n fn kept() {}\n+fn added() {}\n",
      },
    ];
    item("item/started", { type: "fileChange", id: itemId, changes, status: "inProgress" });
    item("item/completed", { type: "fileChange", id: itemId, changes, status: "completed" });
    say("Edited src/lib.rs.", ["Edited ", "src/lib.rs."]);
    return finish("completed");
  }

  const answer = `Echo: ${text}`;
  const third = Math.ceil(answer.length / 3);
  say(answer, [answer.slice(0, third), answer.slice(third, 2 * third), answer.slice(2 * third)]);
  finish("completed");
}

function onLine(line) {
  if (!line.trim()) return;
  let msg;
  try {
    msg = JSON.parse(line);
  } catch {
    return;
  }
  if (msg.method === undefined && msg.id !== undefined) {
    // The client's answer to one of our requests.
    const resolve = waiting.get(msg.id);
    waiting.delete(msg.id);
    resolve?.(msg);
    return;
  }
  if (msg.id === undefined) return; // a notification, such as `initialized`
  handle(msg).catch((e) => write({ id: msg.id, error: { code: -32603, message: String(e) } }));
}

// yardd owns our stdin: when it closes (yardd stopped or was killed), exit,
// even in the middle of a slow turn.
for await (const line of console) onLine(line);
log(`exit pid=${process.pid}`);
process.exit(0);
