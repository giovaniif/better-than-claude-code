#!/usr/bin/env node
// Gemini exposes models on session/new, modes without configOptions, and loadSession.
import { existsSync, mkdirSync, writeFileSync } from "node:fs";
import { runAgent } from "./acp-agent.mjs";
const dir = process.env.FAKE_CODEX_DIR;
const state = process.env.GEMINI_CLI_HOME ? `${process.env.GEMINI_CLI_HOME}/.gemini` : `${dir}/gemini-default`;
const account = process.env.GEMINI_CLI_HOME?.split("/").pop() ?? "default";
if (process.argv.includes("--version")) {
  console.log("0.54.0");
} else if (process.argv.includes("--acp")) {
  runAgent({ engine: "gemini", state, account, loggedIn: () => existsSync(`${state}/logged-in`) || (account === "default" && existsSync(`${dir}/gemini-logged-in`)) });
} else {
  mkdirSync(state, { recursive: true });
  writeFileSync(`${state}/logged-in`, "");
}
