<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The window loads yardd's page over plain http on loopback. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- Dictation and voice mode use the page's Web Speech API. WebKit refuses
       recognition outright (no prompt) when either string is missing. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Switchyard listens while you dictate a message or use voice mode.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Switchyard turns what you say into the text of your message.</string>
</dict>
</plist>
