{
  "$comment": "Agent loops started by verify/yv loop run (systemd user timers, see verify/loops/README.md). Each run is a normal Switchyard session on the live yardd, so it shows in the sidebar and can be steered. Changing this file is a self-or-CI change.",
  "yardUrl": "ws://127.0.0.1:47717/ws",
  "checkout": "~/.local/share/switchyard-loops/switchyard",
  "budget": {
    "$comment": "Skip a run when the engine's usage is above these percentages (5-hour window, week) or the machine is busy.",
    "codex": { "primaryMax": 60, "secondaryMax": 75 },
    "claude": { "fiveHourMax": 70, "sevenDayMax": 80 },
    "maxLoadPerCore": 0.7
  },
  "fallback": null,
  "loops": {
    "patrol": { "engine": "claude", "model": "claude-opus-5-5", "effort": "high", "minutes": 50, "skill": ".claude/skills/patrol/SKILL.md" },
    "maintain": { "engine": "claude", "model": "claude-opus-5-5", "effort": "medium", "minutes": 50, "skill": ".claude/skills/map-maintenance/SKILL.md" },
    "review": { "engine": "claude", "model": "claude-opus-5-5", "effort": "medium", "minutes": 30, "skill": ".claude/skills/weekly-review/SKILL.md" },
    "verify": { "engine": "claude", "model": "claude-opus-5-5", "effort": "high", "minutes": 40, "skill": ".claude/skills/verifier/SKILL.md" },
    "babysit": { "engine": "claude", "model": "claude-opus-5-5", "effort": "medium", "minutes": 40, "skill": ".claude/skills/babysit/SKILL.md" }
  },
  "keepFinishedSessions": 0
}
